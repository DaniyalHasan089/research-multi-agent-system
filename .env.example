# ── LLM Configuration ─────────────────────────────────────────────────────────
# Choose your LLM provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Tiered model selection for Gemini
GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
GEMINI_HEAVY_MODEL=gemini-3.1-flash-lite

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LIGHT_MODEL=gpt-4o-mini
OPENAI_HEAVY_MODEL=gpt-4o

# Generation temperature for synthesis and analysis (default 0.2)
LLM_TEMPERATURE=0.2

# ── Search ────────────────────────────────────────────────────────────────────
# Tavily API key — get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# Maximum number of papers to return from the Analyzer & Ranker
TOP_K_PAPERS=10
